    {
      "id": "story-frame-9",
      "type": "frame",
      "x": 0,
      "y": 2100,
      "width": 1600,
      "height": 900,
      "name": "Slide 09",
      "angle": 0,
      "strokeColor": "#202020",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
