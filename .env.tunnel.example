# Copy to .env.tunnel.local and replace these origins with reserved zrok shares.
FOCACCIA_NETWORK_MODE=tunnel
FOCACCIA_TUNNEL_SUPABASE_URL=https://focaccia-api.share.zrok.io
FOCACCIA_TUNNEL_WEB_URL=https://focaccia-web.share.zrok.io
FOCACCIA_TUNNEL_TICKETS_URL=https://focaccia-tickets.share.zrok.io

# zrok v2 reserved name selections used by demo:tunnel.
FOCACCIA_ZROK_SUPABASE_NAME_SELECTION=public:focaccia-api
FOCACCIA_ZROK_WEB_NAME_SELECTION=public:focaccia-web
FOCACCIA_ZROK_TICKETS_NAME_SELECTION=public:focaccia-tickets

# Server-only. Never expose these through browser or Expo configuration.
FOCACCIA_ORGANIZER_EMAIL_ALLOWLIST=organizer@example.com
FOCACCIA_CLAIM_CODE_PEPPER=replace-with-a-base64url-encoded-32-byte-secret
