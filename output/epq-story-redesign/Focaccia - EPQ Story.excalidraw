    {
      "id": "story-frame-11",
      "type": "frame",
      "x": 3600,
      "y": 2100,
      "width": 1600,
      "height": 900,
      "name": "Slide 11",
      "angle": 0,
      "strokeColor": "#202020",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "isDeleted": false,
      "locked": false,
      "seed": 111,
      "version": 2,
      "versionNonce": 1327791367,
      "customData": {
        "title": "Offline is a trade-off",
        "ao": "AO3 / AO4",
        "structure": "two consequences of disconnection",
        "claim": "Offline entry remains possible, while new cancellation information must wait.",
        "status": "Implemented design with an explicit limitation; offline covers the gate decision only.",
        "sources": [
          "https://app.notion.com/p/3d1d326c13fb800d9fc8e21671d9d3ea — sections 5 and 7",
          "docs/EPQ_ARTIFACT_REPORT.md — Offline Security"
        ],
        "spoken": "Offline entry was another trade-off. If the gate is prepared first, it can make an entry decision without Wi-Fi. But it cannot receive a new cancellation from somewhere else while disconnected. That update has to wait until reconnection. I could not have both complete independence from the network and instant new information. This is why I limited the project to one gate and explained what offline actually means. It applies to entry, while ticket claiming and preparation still need a connection.",
        "cue": "Point to both consequences. Do not imply instant cancellation or synchronised use across disconnected gates."
      },
      "index": "b1M",
      "roundness": null,
      "boundElements": [],
      "updated": 1793165341252,
      "link": null
    },
