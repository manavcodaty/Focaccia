      "isDeleted": false,
      "locked": false,
      "seed": 104,
      "version": 2,
      "versionNonce": 850717040,
      "customData": {
        "title": "How the project changed",
        "spoken": "My original plan focused mainly on the face-checking part. My supervisor asked an important question: how does someone get a ticket in the first place? So I added the public ticket website. I then had to connect that with the organiser system, the phone app and the gate app. I worked on the basic design first, joined the parts together in June, and improved the apps in July. The finished project was more complete, but it also left me less time for proper testing.",
        "keyPoints": "1. Supervisor asked how tickets are obtained.\n2. I added ticketing and connected four parts.\n3. More features meant less time for testing.",
        "originalSlideText": "PROJECT BUILD\nThe project grew as I built it.\nAdding ticketing made it more useful — and left less time for testing.\nPrivate Pass  /  MANAV CODATY\n04\n1\nBuild the base\nCamera, local network, privacy design\n2\nConnect the parts\nTickets, offline checks, syncing\n3\nFix and improve\nLogin, networking, app screens\nTRADE-OFF: MORE FEATURES MEANT FEWER PLANNED BIOMETRIC TESTS",
        "sources": [
          "/Users/manavcodaty/Library/Mobile Documents/com~apple~CloudDocs/Praco Family/EPQ/Mav/PrivatePass_EPQ Presentation_v4.pptx — slide 4"
        ],
        "claim": "How the project changed"
      },
      "index": "ae",
      "roundness": null,
      "boundElements": [],
      "updated": 1793173192618,
      "link": null
    },
