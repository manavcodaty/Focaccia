    {
      "id": "story-frame-19",
      "type": "frame",
      "x": 3600,
      "y": 4200,
      "width": 1600,
      "height": 900,
      "name": "Slide 19",
      "angle": 0,
      "strokeColor": "#202020",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "isDeleted": false,
      "locked": false,
      "seed": 119,
      "version": 2,
      "versionNonce": 984252304,
      "customData": {
        "title": "Questions",
        "spoken": "That's the end of my presentation. I'm happy to answer questions about the design, the testing, or what I'd change if I built it again. The main thing I want to be clear about is that I have a working prototype, but I won't claim that I've tested things I haven't.",
        "keyPoints": "1. Invite questions about design and decisions.\n2. Be clear about saved evidence versus observation.\n3. Be honest about what was not tested.",
        "originalSlideText": "Private Pass  /  MANAV CODATY\n18\nPrivate Pass  /  DISCUSSION\nQUESTIONS?\nThree things worth asking me:\n01\nWhy compare one face with one ticket?\n02\nWhat tests support the offline checks?\n03\nWhat would I test before a real event?",
        "sources": [
          "/Users/manavcodaty/Library/Mobile Documents/com~apple~CloudDocs/Praco Family/EPQ/Mav/PrivatePass_EPQ Presentation_v4.pptx — slide 19"
        ],
        "claim": "Questions",
        "qa": ""
      },
