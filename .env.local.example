# Copy to .env.local and replace 192.168.1.50 with the organizer Mac's stable LAN IPv4.
FOCACCIA_NETWORK_MODE=local
FOCACCIA_LOCAL_HOST=192.168.1.50
FOCACCIA_LOCAL_SUPABASE_URL=http://192.168.1.50:54331
FOCACCIA_LOCAL_WEB_URL=http://192.168.1.50:3000
FOCACCIA_LOCAL_TICKETS_URL=http://192.168.1.50:3001

# Recommended on macOS: Colima with portForwarder=none and Docker over SSH.
FOCACCIA_DOCKER_HOST=ssh://colima

# Server-only. Never copy these into NEXT_PUBLIC_* or EXPO_PUBLIC_* variables.
FOCACCIA_ORGANIZER_EMAIL_ALLOWLIST=organizer@example.com
FOCACCIA_CLAIM_CODE_PEPPER=replace-with-a-base64url-encoded-32-byte-secret
