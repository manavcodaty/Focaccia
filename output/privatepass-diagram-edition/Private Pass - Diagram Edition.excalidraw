    {
      "id": "story-frame-3",
      "type": "frame",
      "x": 3600,
      "y": 0,
      "width": 1600,
      "height": 900,
      "name": "Slide 03",
      "angle": 0,
      "strokeColor": "#202020",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "isDeleted": false,
      "locked": false,
      "seed": 103,
      "version": 2,
      "versionNonce": 1315290480,
      "customData": {
        "title": "My goals",
        "spoken": "I decided on four main goals. First, check the person's face against the face linked to their ticket, rather than searching through a list of people. Second, let a prepared gate make that decision offline. Third, avoid keeping reusable face information on the main server. And fourth, keep evidence of what actually worked. That last point became really important, because making something work once isn't the same as proving it will work reliably.",
        "keyPoints": "1. Match one person to one ticket.\n2. Work offline and limit central face storage.\n3. Keep evidence, not just a working screen.",
        "originalSlideText": "GOALS\nFour checks defined what success meant.\nBuild a working prototype, then test its claims.\nPrivate Pass  /  MANAV CODATY\n03\n1:1 MATCH\nTicket + registered face\nOFFLINE\nGate decides without internet\nPRIVACY\nNo central reusable face records\nEVIDENCE\nSave tests and limits",
        "sources": [
          "/Users/manavcodaty/Library/Mobile Documents/com~apple~CloudDocs/Praco Family/EPQ/Mav/PrivatePass_EPQ Presentation_v4.pptx — slide 3"
        ],
        "claim": "My goals"
      },
      "index": "aS",
      "roundness": null,
      "boundElements": [],
      "updated": 1793173192618,
      "link": null
    },
