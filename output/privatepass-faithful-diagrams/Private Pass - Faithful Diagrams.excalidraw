    {
      "id": "story-frame-7",
      "type": "frame",
      "x": 3600,
      "y": 1050,
      "width": 1600,
      "height": 900,
      "name": "Slide 07",
      "angle": 0,
      "strokeColor": "#202020",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "isDeleted": false,
      "locked": false,
      "seed": 107,
      "version": 2,
      "versionNonce": 1854913484,
      "customData": {
        "title": "Where face data goes",
        "spoken": "This is the main privacy choice in my project. The attendee's phone handles the face image and turns it into a set of numbers. Those numbers are changed for that event and protected inside the pass. The main server still keeps things like accounts, events and ticket records, because the system needs them. But it isn't meant to keep a central collection of reusable faces. The gate checks the protected face information on its own device. This reduces one privacy risk; it doesn't remove every risk.",
        "keyPoints": "1. Face is processed on the attendee phone.\n2. Server stores ticket records, not reusable faces.\n3. Gate checks locally; some risk remains.",
        "originalSlideText": "DATA FLOW\nThe important choice: where face data goes.\nThe event service stores normal ticket records, not a reusable face database.\nPrivate Pass  /  MANAV CODATY\n07\nATTENDEE PHONE\nFace processed on-device\nCENTRAL SERVICE\nAccounts, events, tickets\nPREPARED GATE\nReads protected face data\nLESS CENTRAL FACE DATA DOES NOT MEAN ZERO RISK",
        "sources": [
          "/Users/manavcodaty/Library/Mobile Documents/com~apple~CloudDocs/Praco Family/EPQ/Mav/PrivatePass_EPQ Presentation_v4.pptx — slide 7"
        ],
        "claim": "Where face data goes"
      },
      "index": "b0S",
      "roundness": null,
      "boundElements": [],
      "updated": 1793174454816,
      "link": null
    },
