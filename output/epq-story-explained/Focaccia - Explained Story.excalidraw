      "seed": 116,
      "version": 2,
      "versionNonce": 1500130166,
      "customData": {
        "title": "My management lesson",
        "ao": "AO1 / AO4",
        "structure": "cause and revised plan",
        "claim": "Development expansion displaced evaluation; future work should protect testing time.",
        "status": "Candidate reflection grounded in the report, not a fabricated schedule.",
        "sources": [
          "https://app.notion.com/p/3d1d326c13fb800d9fc8e21671d9d3ea — section 8",
          "https://app.notion.com/p/34ad326c13fb80df8615eae09d66a7f7 — revised plan and evidence gaps",
          "https://app.notion.com/p/335d326c13fb800ea6bfc9216ed9487f — planned evaluation period"
        ],
        "spoken": "My biggest management mistake was letting development take time away from evaluation. Adding ticket claiming improved the product, but every new connection created more debugging and recovery work. Next time I would stop adding features earlier and protect a separate testing period. I would record each attempt as it happened, including failures, and compare the system with ordinary tickets. That would give me a stronger answer than simply adding more features. It also changes how I understand successful project work.",
        "cue": "The plan is a proposed improvement. No actual time proportions or completed dates are shown."
      },
      "index": "b2q",
      "roundness": null,
      "boundElements": [],
      "updated": 1793166443808,
      "link": null
    },
