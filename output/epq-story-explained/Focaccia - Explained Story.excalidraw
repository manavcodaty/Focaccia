    {
      "id": "story-frame-9",
      "type": "frame",
      "x": 0,
      "y": 2100,
      "width": 1600,
      "height": 900,
      "name": "Slide 09",
      "angle": 0,
      "strokeColor": "#202020",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "isDeleted": false,
      "locked": false,
      "seed": 109,
      "version": 2,
      "versionNonce": 1619801322,
      "customData": {
        "title": "The one architecture explanation",
        "ao": "AO3",
        "structure": "sealed-envelope journey",
        "claim": "The attendee protects the face record; the service checks and signs the pass; the gate opens and compares locally.",
        "status": "Implemented design. Analogy does not mean zero personal data or zero device risk.",
        "sources": [
          "https://app.notion.com/p/3d1d326c13fb800d9fc8e21671d9d3ea — sections 4 and 5",
          "docs/PRIVACY_BY_DESIGN.md",
          "docs/EPQ_ARTIFACT_REPORT.md — Privacy-Preserving Biometric Flow"
        ],
        "spoken": "Think of the face record as being inside a locked envelope. The attendee's phone locks it. The event service checks the ticket and seals the pass, without needing to read that protected record. The prepared gate phone can open it and compare it with a fresh face scan. This is only an analogy: the phones still handle sensitive information, and ordinary accounts and tickets remain on the server. Keeping the jobs separate helped me decide where information belonged. Connecting those jobs exposed practical failures.",
        "cue": "Encryption is the lock; signing is the seal. The gate decrypts locally. Do not say encrypted matching or that nothing is stored."
      },
      "index": "b13",
      "roundness": null,
      "boundElements": [],
      "updated": 1793166443808,
      "link": null
    },
