    {
      "id": "story-frame-15",
      "type": "frame",
      "x": 3600,
      "y": 3150,
      "width": 1600,
      "height": 900,
      "name": "Slide 15",
      "angle": 0,
      "strokeColor": "#202020",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "isDeleted": false,
      "locked": false,
      "seed": 115,
      "version": 2,
      "versionNonce": 116235399,
      "customData": {
        "title": "Choice and trust",
        "ao": "AO2 / AO4",
        "structure": "attendee choice fork",
        "claim": "Real use would require meaningful choice and user evidence.",
        "status": "Ethical requirement and future work. No completed preference study or delivered fallback workflow claimed.",
        "sources": [
          "https://app.notion.com/p/2b0d326c13fb809fa29fed44ca56eff0 — consent and opt-out",
          "https://app.notion.com/p/34ad326c13fb80538192eafaa151ad93 — user feedback request",
          "https://app.notion.com/p/3d1d326c13fb800d9fc8e21671d9d3ea — section 7"
        ],
        "spoken": "Even if a system works, people may not want to use their face to enter an event. They should understand what happens to their information and have a genuine alternative. My supervisor asked for feedback from potential users, but I did not complete that wider study. I cannot assume that my privacy priorities match theirs. Ordinary tickets may be simpler for some events. Before real use, I would need to ask people, test the alternative route and justify the extra face step.",
        "cue": "Both routes are requirements for a responsible deployment, not a claim that the final prototype includes a complete staffed alternative."
      },
      "index": "b2G",
      "roundness": null,
      "boundElements": [],
      "updated": 1793165341252,
      "link": null
    },
