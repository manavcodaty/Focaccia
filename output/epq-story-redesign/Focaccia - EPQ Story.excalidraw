      "width": 1600,
      "height": 900,
      "name": "Slide 05",
      "angle": 0,
      "strokeColor": "#202020",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "isDeleted": false,
      "locked": false,
      "seed": 105,
      "version": 2,
      "versionNonce": 2011028455,
      "customData": {
        "title": "Research changed the design",
        "ao": "AO2",
        "structure": "assumption and consequences",
        "claim": "Numerical face records can remain sensitive, motivating local processing and event-specific protection.",
        "status": "Research influence. Protection is a design choice, not proof of impossible reconstruction.",
        "sources": [
          "https://app.notion.com/p/3d1d326c13fb800d9fc8e21671d9d3ea — section 3",
          "https://arxiv.org/abs/1703.00832 — Mai et al., reconstruction research",
          "https://biometrics.cse.msu.edu/Publications/SecureBiometrics/JainNandakumarNagar_TemplateSecuritySurvey_EURASIP08.pdf"
        ],
        "spoken": "I initially thought turning a face into numbers might solve the privacy problem. Research showed why that was too simple. Mai and colleagues showed that face images could be reconstructed from some numerical face records. Other research discussed making protected records replaceable and less reusable between systems. So I kept face processing on the phones and used event-specific protection. I could explain why those decisions reduced exposure, but I could not honestly call the result anonymous or impossible to reverse.",
        "cue": "Say “face numbers” before introducing “record”. Avoid explaining embeddings or cryptography."
      },
      "index": "am",
      "roundness": null,
      "boundElements": [],
      "updated": 1793165341252,
      "link": null
    },
