      "locked": false,
      "seed": 107,
      "version": 2,
      "versionNonce": 251852534,
      "customData": {
        "title": "A plan with dependencies",
        "ao": "AO1",
        "structure": "dependency timeline with review loop",
        "claim": "Later stages depended on earlier stages and required recorded review.",
        "status": "Planned sequence and reflection; no invented completed milestone dates.",
        "sources": [
          "https://app.notion.com/p/335d326c13fb800ea6bfc9216ed9487f — next steps and deadlines",
          "https://app.notion.com/p/3d1d326c13fb800d9fc8e21671d9d3ea — section 2"
        ],
        "spoken": "I divided the work into research, event setup, the face step, gate checking and evaluation. The order mattered because a gate cannot check a pass that the earlier stages cannot create. The logbook was where I recorded decisions and changes to the plan. When a connection failed, I had to go back, fix it and check again. Looking back, I was better at keeping the build moving than protecting the time for evaluation. A later change made that harder.",
        "cue": "The return arrow represents iteration. This is not a dated Gantt chart."
      },
      "index": "b0S",
      "roundness": null,
      "boundElements": [],
      "updated": 1793166443808,
      "link": null
    },
