      "isDeleted": false,
      "locked": false,
      "seed": 110,
      "version": 2,
      "versionNonce": 1016773063,
      "customData": {
        "title": "One failure, one decision",
        "ao": "AO3",
        "structure": "retry contrast",
        "claim": "A lost confirmation must not turn a retry into a second ticket.",
        "status": "Implementation problem and response recorded in the report; no new live test claimed.",
        "sources": [
          "https://app.notion.com/p/3d1d326c13fb800d9fc8e21671d9d3ea — section 4",
          "docs/PHASE_9_FINAL_DUAL_MODE_ACCEPTANCE.md — integration results"
        ],
        "spoken": "One problem was what happened when a reply disappeared. The service could create a ticket, but the phone might never receive the confirmation. If the person tapped again, the system needed to recognise a retry instead of creating another ticket. I used a remembered request identifier so the same request returned the same result. That taught me to think beyond the happy path. I needed to ask what remained after an interruption, not only what happened when everything worked.",
        "cue": "The upper row is a failure risk. The lower row shows the implemented retry behaviour."
      },
      "index": "b12",
      "roundness": null,
      "boundElements": [],
      "updated": 1793165341252,
      "link": null
    },
