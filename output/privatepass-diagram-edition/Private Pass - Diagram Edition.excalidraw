      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "isDeleted": false,
      "locked": false,
      "seed": 110,
      "version": 2,
      "versionNonce": 133868912,
      "customData": {
        "title": "The offline gate decision",
        "spoken": "Before the event, the gate downloads the information it needs. After that, it can work without internet. It checks that the ticket is for the right event, that it hasn't been changed, that it hasn't already been used, and that the face matches. If everything passes, entry is allowed and the ticket is marked as used. There's one important limit: if a ticket is cancelled while the gate is offline, the gate won't know until it reconnects.",
        "keyPoints": "1. Prepare the gate before going offline.\n2. Check ticket, use status and face.\n3. New cancellations cannot arrive while offline.",
        "originalSlideText": "OFFLINE ENTRY\nThe gate can decide without internet.\nIt uses event data downloaded before the event.\nPrivate Pass  /  MANAV CODATY\n10\n✓\nCorrect event and time\n✓\nValid digital signature\n✓\nNot cancelled or already used\n✓\nFace matches the ticket\nFIRST VALID SCAN\nACCEPT\nSECOND SCAN → REJECT\nLIMIT: THE GATE CANNOT SEE A NEW CANCELLATION UNTIL IT RECONNECTS",
        "sources": [
          "/Users/manavcodaty/Library/Mobile Documents/com~apple~CloudDocs/Praco Family/EPQ/Mav/PrivatePass_EPQ Presentation_v4.pptx — slide 10"
        ],
        "claim": "The offline gate decision"
      },
      "index": "b1G",
      "roundness": null,
      "boundElements": [],
      "updated": 1793173192618,
      "link": null
    },
