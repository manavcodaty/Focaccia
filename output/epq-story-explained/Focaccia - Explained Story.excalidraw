      "groupIds": [],
      "frameId": null,
      "isDeleted": false,
      "locked": false,
      "seed": 102,
      "version": 2,
      "versionNonce": 1248399402,
      "customData": {
        "title": "Why I chose Focaccia",
        "ao": "AO1",
        "structure": "converging motivations",
        "claim": "Personal coding interests led to a question about minimising facial data.",
        "status": "Candidate motivation and latest working question; final title approval still needs recording.",
        "sources": [
          "https://app.notion.com/p/2b0d326c13fb809fa29fed44ca56eff0 — personal interests",
          "https://app.notion.com/p/34ad326c13fb80538192eafaa151ad93 — final title refinement, 21 August 2026"
        ],
        "spoken": "I chose this because I enjoy coding and wanted to build something useful, rather than only write about an idea. A password can be changed after a leak. Your face is much harder to replace. My question became how effectively Focaccia could provide offline event entry while minimising central storage of reusable face data. In everyday language: could the gate check the person while the organiser kept less facial information? I needed a manageable way to investigate that.",
        "cue": "The wording on the slide is a plain-English explanation. The full working title is in the sources."
      },
      "index": "aD",
      "roundness": null,
      "boundElements": [],
      "updated": 1793166443808,
      "link": null
    },
