      "isDeleted": false,
      "locked": false,
      "seed": 112,
      "version": 2,
      "versionNonce": 713739207,
      "customData": {
        "title": "A short demonstration",
        "ao": "AO3 / AO4",
        "structure": "three-step demonstration",
        "claim": "A prepared gate should accept once offline and reject reuse at that gate.",
        "status": "Demonstration instructions and expected outcomes. No live demo testing during this redesign.",
        "sources": [
          "https://app.notion.com/p/34ad326c13fb80538192eafaa151ad93 — presentation plan",
          "docs/EPQ_OPERATIONS_MANUAL.md",
          "https://app.notion.com/p/34ad326c13fb80df8615eae09d66a7f7 — candidate-attested run"
        ],
        "spoken": "For the demonstration, watch three things. First, the prepared gate loses its connection. Then the pass is scanned once and should be accepted. Finally, the same pass is scanned again and should be rejected because this gate remembers using it. Afterwards, I can reconnect and show the organiser's record updating. This demonstrates a specific journey. It does not measure how accurately the face check works for lots of different people. That difference matters when I judge my result.",
        "cue": "Reserve 2 minutes. Prepare a consenting attendee, an unused pass and a refreshed gate beforehand. Disable network only after preparation. Accept once, retry the identical pass at the same gate, then reconnect and synchronise. If unavailable, use only a recording you actually made; label it recorded. Otherwise describe expected states without pretending a demonstration happened."
      },
      "index": "b1Y",
      "roundness": null,
      "boundElements": [],
      "updated": 1793165341252,
      "link": null
    },
