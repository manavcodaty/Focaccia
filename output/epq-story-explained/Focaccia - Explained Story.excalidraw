    {
      "id": "story-frame-3",
      "type": "frame",
      "x": 3600,
      "y": 0,
      "width": 1600,
      "height": 900,
      "name": "Slide 03",
      "angle": 0,
      "strokeColor": "#202020",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "isDeleted": false,
      "locked": false,
      "seed": 103,
      "version": 2,
      "versionNonce": 1268172330,
      "customData": {
        "title": "A manageable scope",
        "ao": "AO1 / AO3",
        "structure": "scope ladder",
        "claim": "The investigation was limited to one event and one prepared gate.",
        "status": "Recorded scope decision. No public rollout or multi-gate claim.",
        "sources": [
          "https://app.notion.com/p/335d326c13fb800ea6bfc9216ed9487f — modifications",
          "https://app.notion.com/p/3d1d326c13fb800d9fc8e21671d9d3ea — section 2"
        ],
        "spoken": "My first plan combined privacy, face matching, offline entry, speed and user testing. Each part brought more work. A whole commercial event platform was too big, but an isolated face scan would not answer the question either. I settled on one controlled event and one prepared gate phone. That gave me a realistic boundary. It also meant leaving payments and multiple gates outside the main investigation. My supervisor helped me see why that boundary mattered.",
        "cue": "The levels represent scope, not measured performance or project size."
      },
      "index": "aT",
      "roundness": null,
      "boundElements": [],
      "updated": 1793166443808,
      "link": null
    },
