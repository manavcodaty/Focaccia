    {
      "id": "story-frame-6",
      "type": "frame",
      "x": 1800,
      "y": 1050,
      "width": 1600,
      "height": 900,
      "name": "Slide 06",
      "angle": 0,
      "strokeColor": "#202020",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "isDeleted": false,
      "locked": false,
      "seed": 106,
      "version": 2,
      "versionNonce": 2069806646,
      "customData": {
        "title": "Research is not my test result",
        "ao": "AO2 / AO4",
        "structure": "separated evidence bridge",
        "claim": "Published research guides a build but does not measure Focaccia.",
        "status": "Critical source evaluation, no imported accuracy or speed percentages.",
        "sources": [
          "https://app.notion.com/p/3d1d326c13fb800d9fc8e21671d9d3ea — sections 3, 6 and bibliography",
          "https://app.notion.com/p/2b0d326c13fb809fa29fed44ca56eff0 — intended resources"
        ],
        "spoken": "I also learned to ask what each source could actually tell me. Research papers helped explain possibilities and risks. Official documentation helped me connect existing tools. But a published result came from someone else's model, people and conditions. It was not a result for my phone. I used sources to choose an approach, then needed my own tests to judge the artefact. That distinction stopped me borrowing impressive accuracy or speed claims that I had not measured.",
        "cue": "Explain the gap between the two sides. It is an evidence gap, not a claim that the papers are unreliable."
      },
      "index": "b0E",
      "roundness": null,
      "boundElements": [],
      "updated": 1793166443808,
      "link": null
    },
