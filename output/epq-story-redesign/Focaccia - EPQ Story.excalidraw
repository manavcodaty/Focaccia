      "frameId": null,
      "isDeleted": false,
      "locked": false,
      "seed": 113,
      "version": 2,
      "versionNonce": 803546087,
      "customData": {
        "title": "How strong is the evidence?",
        "ao": "AO4",
        "structure": "evidence comparison",
        "claim": "Retained software records and a candidate-reported full run have different evidential strength.",
        "status": "Retained dated records versus candidate-attested experience; no accuracy dataset.",
        "sources": [
          "https://app.notion.com/p/34ad326c13fb80df8615eae09d66a7f7 — evidence classification",
          "https://app.notion.com/p/3d1d326c13fb800d9fc8e21671d9d3ea — section 6",
          "docs/PHASE_9_FINAL_DUAL_MODE_ACCEPTANCE.md — ESCALATED - NOT ACCEPTED"
        ],
        "spoken": "My evaluation has an important weakness. I report completing the whole journey successfully, but I did not retain a detailed receipt of every device, build and step. Earlier checks have stronger records, including software and browser results, but their physical acceptance stage remained incomplete. I should not merge those into one stronger claim. A successful journey is useful evidence of connection between parts. It is not a repeated accuracy study, and the missing record limits how confidently someone else can verify my observation.",
        "cue": "Candidate-attested means reported by you, not independently evidenced. The June acceptance record is dated and does not validate every later change."
      },
      "index": "b1q",
      "roundness": null,
      "boundElements": [],
      "updated": 1793165341252,
      "link": null
    },
