    {
      "id": "story-frame-4",
      "type": "frame",
      "x": 5400,
      "y": 0,
      "width": 1600,
      "height": 900,
      "name": "Slide 04",
      "angle": 0,
      "strokeColor": "#202020",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "isDeleted": false,
      "locked": false,
      "seed": 104,
      "version": 2,
      "versionNonce": 1660648967,
      "customData": {
        "title": "Three questions from my supervisor",
        "ao": "AO1 / AO3",
        "structure": "feasibility triangle",
        "claim": "Feasibility, differentiation and evidence all had to support the project.",
        "status": "Supervisor feedback, paraphrased from the logbook.",
        "sources": [
          "https://app.notion.com/p/289d326c13fb80c69689d1cedce8fc19 — supervisor comments",
          "https://app.notion.com/p/335d326c13fb800ea6bfc9216ed9487f — supervisor advice"
        ],
        "spoken": "My supervisor pushed me on three questions. Could I actually build it? What made it different from systems that already existed? And how would I prove that it worked? Those questions belong together. Something original is not useful if I cannot finish it. A finished app is not enough if I cannot evaluate it. This helped me make privacy the centre of the investigation and connect my technical choices to evidence. Research then challenged one of my own assumptions.",
        "cue": "Move around the triangle once, then explain the connection between its corners."
      },
      "index": "aY",
      "roundness": null,
      "boundElements": [],
      "updated": 1793165341252,
      "link": null
    },
