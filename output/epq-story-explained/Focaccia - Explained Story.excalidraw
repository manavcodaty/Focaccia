      "seed": 101,
      "version": 2,
      "versionNonce": 1201280694,
      "customData": {
        "title": "A copied ticket",
        "ao": "AO1",
        "structure": "copy comparison",
        "claim": "A ticket code can be copied without copying its owner.",
        "status": "Problem framing, not a measured fraud rate.",
        "sources": [
          "https://app.notion.com/p/34ad326c13fb80538192eafaa151ad93 — original problem",
          "https://app.notion.com/p/3d1d326c13fb800d9fc8e21671d9d3ea — section 1"
        ],
        "spoken": "Imagine sending a screenshot of your ticket to someone else. They now have exactly the same code. The code can show that the ticket is valid, but it cannot show who is holding it. That was my starting problem. I wondered whether checking the person as well as the ticket could help. But using a face creates another question: what happens to that very personal information afterwards? That question became the reason for my project.",
        "cue": "Ask the audience to imagine a shared ticket. Do not invite them to share real passes."
      },
      "index": "a0",
      "roundness": null,
      "boundElements": [],
      "updated": 1793166443808,
      "link": null
    },
