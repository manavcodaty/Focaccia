    {
      "id": "story-frame-8",
      "type": "frame",
      "x": 5400,
      "y": 1050,
      "width": 1600,
      "height": 900,
      "name": "Slide 08",
      "angle": 0,
      "strokeColor": "#202020",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "isDeleted": false,
      "locked": false,
      "seed": 108,
      "version": 2,
      "versionNonce": 836911504,
      "customData": {
        "title": "How the face check works",
        "spoken": "When someone reaches the gate, the system isn't trying to find them in a crowd. It already has their ticket, so it only needs to ask: does this person match the face linked to this pass? The phone compares two sets of numbers made from the face. There is a limit for deciding how close they need to be. If that limit is too strict, the right person might be rejected. If it's too loose, the wrong person might get in. I didn't run enough tests to give a reliable accuracy figure.",
        "keyPoints": "1. Check one person against one ticket.\n2. The matching limit affects false rejections and acceptance.\n3. No reliable measured accuracy figure.",
        "originalSlideText": "FACE CHECK\nOne person is compared with one ticket.\nNo search through a crowd or a central face database.\nPrivate Pass  /  MANAV CODATY\n08\nLOCAL\nMODEL\nLIVE FACE\nPASS TEMPLATE\nEVENT A ≠ EVENT B\nThe same face is represented differently for each event.\nNOT PROVEN: UNLINKABILITY",
        "sources": [
          "/Users/manavcodaty/Library/Mobile Documents/com~apple~CloudDocs/Praco Family/EPQ/Mav/PrivatePass_EPQ Presentation_v4.pptx — slide 8"
        ],
        "claim": "How the face check works"
      },
      "index": "b0l",
      "roundness": null,
      "boundElements": [],
      "updated": 1793173192618,
      "link": null
    },
