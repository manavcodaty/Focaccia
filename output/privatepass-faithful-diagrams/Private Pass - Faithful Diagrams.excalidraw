    {
      "id": "story-frame-6",
      "type": "frame",
      "x": 1800,
      "y": 1050,
      "width": 1600,
      "height": 900,
      "name": "Slide 06",
      "angle": 0,
      "strokeColor": "#202020",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "isDeleted": false,
      "locked": false,
      "seed": 106,
      "version": 2,
      "versionNonce": 1768642548,
      "customData": {
        "title": "Four parts of Private Pass",
        "spoken": "Private Pass has four connected parts. The organiser creates an event. The attendee then uses a website to claim a ticket. Next, the enrolment app uses the phone camera to register the attendee's face and prepare their pass. Finally, at the event, the gate app checks the pass and the person's face. The important detail is that the final check can work offline, but the earlier steps still need the main system to be online.",
        "keyPoints": "1. Organiser creates the event.\n2. Attendee claims a ticket and registers their face.\n3. Prepared gate checks locally without internet.",
        "originalSlideText": "SYSTEM\nFour parts. One ticket journey.\nPrivate Pass  /  MANAV CODATY\n06\nORGANISER\nCreates an event\nTICKETS\nAttendee claims a ticket\nENROLMENT\nPhone registers face\nGATE\nChecks pass + face offline\nTHE GATE’S FINAL ENTRY CHECK WORKS WITHOUT A LIVE CONNECTION",
        "sources": [
          "/Users/manavcodaty/Library/Mobile Documents/com~apple~CloudDocs/Praco Family/EPQ/Mav/PrivatePass_EPQ Presentation_v4.pptx — slide 6"
        ],
        "claim": "Four parts of Private Pass"
      },
      "index": "b09",
      "roundness": null,
      "boundElements": [],
      "updated": 1793174454816,
      "link": null
    },
